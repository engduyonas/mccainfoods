{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Set your Cloudflare account ID from dash.cloudflare.com (right sidebar) after `wrangler login`
   "account_id": "566a1a7827a9a9a27e3e05d87245167f",
  "main": ".open-next/worker.js",
  "name": "mccainfoods",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mccainfoods"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
